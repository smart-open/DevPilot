# ============================================================
# DevPilot 环境变量配置模板
# 
# 使用方式：
#   方式 1（推荐）：运行 ./init.sh 交互式配置向导
#   方式 2：cp .env.example .env && vim .env
#
# 标记说明：
#   [必填] 必须手动填入实际值
#   [自动] 首次部署时自动生成（也可手动指定）
#   [可选] 有默认值，按需修改
# ============================================================

# ============================================================
# 大模型平台配置（选择任一平台即可，所有平台均支持 OpenAI Chat Completion 协议）
# ============================================================
# 平台选择：agnes、deepseek、glm（智谱）、ark（火山方舟）、bailian（百炼）
LLM_PLATFORM=agnes

# ============================================================
# 1. Agnes AI 平台
# ============================================================
AGNES_API_KEY=your-agnes-api-key
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AGNES_MODEL=agnes-2.5-flash

# ============================================================
# 2. DeepSeek 平台
# ============================================================
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=DeepSeek-V4-Flash
DEEPSEEK_CODE_MODEL=DeepSeek-V4-Flash

# ============================================================
# 3. 智谱 GLM 平台
# ============================================================
GLM_API_KEY=your-glm-api-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=GLM-5.2

# ============================================================
# 4. 火山方舟平台
# ============================================================
ARK_API_KEY=your-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2.1-turbo
ARK_CODE_PLAN_MODEL=doubao-seed-2.1-turbo

# ============================================================
# 5. 百炼平台
# ============================================================
BAILIAN_API_KEY=your-bailian-api-key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=Qwen3.7-Plus

# ============================================================
# 飞书机器人配置
# ============================================================
# WebSocket 长连接模式仅需 App ID 和 App Secret
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
# 机器人显示名称（可选，默认 DevPilot助手）
FEISHU_BOT_NAME=DevPilot助手

# ============================================================
# Redis 配置
# ============================================================
# 密码会在首次部署时自动生成（init.sh 或 deploy.sh）
# 也可手动设置为自定义密码
REDIS_PASSWORD=change-me-to-strong-password
# 对外发布端口（宿主机监听端口 -> 容器 6379，默认 6379）
# 供宿主机 / 局域网客户端直连；修改后需重建容器生效：docker compose up -d redis
# 安全提示：对外发布依赖 REDIS_PASSWORD 强密码，生产环境建议防火墙限制来源 IP
REDIS_PORT=6379

# ============================================================
# OpenClaw 配置
# ============================================================
# Gateway 认证 Token（浏览器访问 OpenClaw Dashboard 时输入）。
# 留空或保持占位符 change-me-to-secure-token 时，容器首次启动会自动生成安全随机 Token（日志中可见）。
# 虚拟机 / 局域网经 http://<宿主机IP>:18789 访问时，已默认开启 controlUi.allowInsecureAuth 放行 WebSocket。
# 注意：OpenClaw 已改为 bridge 网络，局域网浏览器访问需在 .env 设置 DEVPILOT_HOST_IP（见下方）以通过来源白名单。
OPENCLAW_GATEWAY_TOKEN=change-me-to-secure-token
OPENCLAW_GATEWAY_PORT=18789
# Agent 默认模型（可选，格式 <平台>/<模型>，如 glm/GLM-5.2）
# 不设置时使用 LLM_PLATFORM 对应平台的 <平台>_MODEL。技能路由（/deploy 等斜杠命令）
# 与 G1→G5 开发流程的遵循度强依赖模型能力：轻量档（flash/turbo/mini）常绕过技能
# 自由发挥（不按 SKILL.md 执行、不走 G 链），建议为 Agent 显式指定强模型。
# 可跨平台指定（如 LLM_PLATFORM=agnes 时仍可 OPENCLAW_MODEL=glm/GLM-5.2），
# 前提是对应平台的 API Key 与 Base URL 已配置，否则启动时会告警并回退平台默认模型。
# OPENCLAW_MODEL=glm/GLM-5.2
# Web UI HTTP 明文访问放行（controlUi.allowInsecureAuth + gateway --allow-unconfigured）
# 默认 true 兼容 VM/内网直连 http 访问；生产环境套反向代理终止 TLS 后应设为 false。
DEVPILLOT_INSECURE_AUTH=true
# 宿主机可达 IP（bridge 网络远程访问用，可选）
# OpenClaw 改为 bridge 网络后，容器内探测到的 IP 是 172.x 内网地址，对局域网浏览器无意义。
# 设置本机 LAN IP（如 192.168.1.100）后，脚本将其写入 allowedOrigins，使局域网浏览器
# 经 http://<该IP>:18789 访问时 WebSocket/CORS 校验通过。留空则自动探测（仅 localhost/SSH 隧道可用）。
DEVPILOT_HOST_IP=

# ============================================================
# LiteLLM 代理配置（复刻 CC-Switch 本地路由）
# ============================================================
# litellm master_key：Claude Code 经同容器（devpilot-claude-litellm）内置 litellm（http://127.0.0.1:4000）访问时携带的鉴权密钥，
#                     必须与 docker-compose 中 devpilot-claude-litellm 容器 litellm 的 general_settings.master_key 一致。
# [自动] init.sh 配置向导会自动生成 32 位随机值并写入此处；
#        手动部署时必须设置为 32+ 位随机字符串（切勿使用弱默认值）。
# 注意：留空或保持占位符时，litellm 与 Claude Code（devpilot-claude-litellm 容器）将拒绝启动（强制安全）。
LITELLM_MASTER_KEY=change-me-to-strong-litellm-key
# litellm 代理地址（一般无需改；如自定义部署可指向其它 litellm 端点）
# 注意：此默认值供 devpilot-claude-litellm 容器【内部】同容器回环访问（127.0.0.1:4000）。
# 跨容器的 OpenClaw 在 docker-compose 中已单独覆盖为服务名
# http://devpilot-claude-litellm:4000（bridge 网络经服务名访问，不经宿主机端口）。
LITELLM_PROXY_URL=http://127.0.0.1:4000

# ============================================================
# SSH 受控部署通道（可选，Phase 2）
# ============================================================
# 开启后，飞书 /deploy 的构建/部署/清理类命令自动经 SSH 转发宿主机执行
# （宿主机才有 docker daemon）。宿主机侧一键配置：sudo bash scripts/setup-deploy-ssh.sh
# 密钥锁定为 forced-command（只能执行部署处理器，无法跑任意命令）。
# 目标主机：默认 host.docker.internal（compose 已映射到宿主机）；也可填宿主机 LAN IP。
# 留空 = 不启用，行为与之前一致（构建类命令被拦截并提示宿主机手动执行）。
# DEPLOY_SSH_HOST=host.docker.internal
# SSH 受控用户（与 scripts/setup-deploy-ssh.sh 创建的用户一致，默认 devpilot-deploy）
# DEPLOY_SSH_USER=devpilot-deploy

# ============================================================
# 时区配置
# ============================================================
TZ=Asia/Shanghai

# ============================================================
# 服务自动部署配置
# ============================================================
DEVPILOT_AUTO_DEPLOY=false

# ============================================================
# 组件版本配置（已集成到 versions.env，无需在此配置）
# ============================================================
# source ./versions.env  # init.sh 会自动加载

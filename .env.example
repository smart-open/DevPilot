# ============================================================
# DevPilot 环境变量配置模板
# 
# 使用方式：
#   方式 1（推荐）：运行 ./init.sh 交互式配置向导
#   方式 2：cp .env.example .env && vim .env
#
# 标记说明：
#   [必填] 必须手动填入实际值
#   [自动] 首次部署时自动生成（也可手动指定）
#   [可选] 有默认值，按需修改
# ============================================================

# ---- [必填] agnes-ai 大模型配置 ----
AGNES_API_KEY=your-agnes-api-key
# [可选] API 地址（一般无需修改）
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# [可选] 默认模型名称
AGNES_MODEL_FLASH=agnes-2.0-flash

# ---- [必填] 飞书配置 ----
# WebSocket 长连接模式仅需 App ID 和 App Secret
# 在飞书开放平台创建"企业自建应用"，启用长连接模式
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret

# ---- [自动] Redis 配置 ----
# 密码会在首次部署时自动生成（init.sh 或 deploy.sh）
# 也可手动设置为自定义密码
REDIS_PASSWORD=change-me-to-strong-password

# ---- [自动] OpenClaw 配置 ----
# Gateway Token 会在首次部署时自动生成
OPENCLAW_GATEWAY_TOKEN=change-me-to-secure-token
# [可选] Gateway 端口
OPENCLAW_GATEWAY_PORT=18789

# ---- [可选] CC-Switch Web 配置 ----
CC_SWITCH_WEB_PORT=8890

# ---- [可选] 时区 ----
TZ=Asia/Shanghai

# ---- [可选] 服务自动部署 ----
# 开发完成后自动部署 workspace/ 下有变更的服务
# true: 启用自动部署  false: 关闭（默认）
DEVPILOT_AUTO_DEPLOY=false

# ============================================================
# 组件版本配置
# 版本号统一在 versions.env 中管理，修改版本只需编辑该文件
# 以下变量由 versions.env 自动加载，如需覆盖可取消注释
# ============================================================
# source ./versions.env  # init.sh 会自动加载

# ============================================================
# DevPilot 环境变量配置模板
# 
# 使用方式：
#   方式 1（推荐）：运行 ./init.sh 交互式配置向导
#   方式 2：cp .env.example .env && vim .env
#
# 标记说明：
#   [必填] 必须手动填入实际值
#   [自动] 首次部署时自动生成（也可手动指定）
#   [可选] 有默认值，按需修改
# ============================================================

# ============================================================
# 大模型平台配置（选择任一平台即可，所有平台均支持 OpenAI Chat Completion 协议）
# ============================================================
# 平台选择：agnes、deepseek、glm（智谱）、ark（火山方舟）、bailian（百炼）
LLM_PLATFORM=agnes

# ============================================================
# 1. Agnes AI 平台
# ============================================================
AGNES_API_KEY=your-agnes-api-key
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AGNES_MODEL=agnes-2.5-flash

# ============================================================
# 2. DeepSeek 平台
# ============================================================
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=DeepSeek-V4-Flash
DEEPSEEK_CODE_MODEL=DeepSeek-V4-Flash

# ============================================================
# 3. 智谱 GLM 平台
# ============================================================
GLM_API_KEY=your-glm-api-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=GLM-5.2

# ============================================================
# 4. 火山方舟平台
# ============================================================
ARK_API_KEY=your-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2.1-turbo
ARK_CODE_PLAN_MODEL=doubao-seed-2.1-turbo

# ============================================================
# 5. 百炼平台
# ============================================================
BAILIAN_API_KEY=your-bailian-api-key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=Qwen3.7-Plus

# ============================================================
# 飞书机器人配置
# ============================================================
# WebSocket 长连接模式仅需 App ID 和 App Secret
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
# 机器人显示名称（可选，默认 DevPilot助手）
FEISHU_BOT_NAME=DevPilot助手

# ============================================================
# Redis 配置
# ============================================================
# 密码会在首次部署时自动生成（init.sh 或 deploy.sh）
# 也可手动设置为自定义密码
REDIS_PASSWORD=change-me-to-strong-password

# ============================================================
# OpenClaw 配置
# ============================================================
# Gateway 认证 Token（浏览器访问 OpenClaw Dashboard 时输入）。
# 留空或保持占位符 change-me-to-secure-token 时，容器首次启动会自动生成安全随机 Token（日志中可见）。
# 虚拟机 / 局域网经 http://<VM_IP>:18789 访问时，已默认开启 controlUi.allowInsecureAuth 放行 WebSocket。
OPENCLAW_GATEWAY_TOKEN=change-me-to-secure-token
OPENCLAW_GATEWAY_PORT=18789
# Web UI HTTP 明文访问放行（controlUi.allowInsecureAuth + gateway --allow-unconfigured）
# 默认 true 兼容 VM/内网直连 http 访问；生产环境套反向代理终止 TLS 后应设为 false。
DEVPILLOT_INSECURE_AUTH=true

# ============================================================
# LiteLLM 代理配置（复刻 CC-Switch 本地路由）
# ============================================================
# litellm master_key：Claude Code 经同容器（devpilot-claude-litellm）内置 litellm（http://127.0.0.1:4000）访问时携带的鉴权密钥，
#                     必须与 docker-compose 中 devpilot-claude-litellm 容器 litellm 的 general_settings.master_key 一致。
# [自动] init.sh 配置向导会自动生成 32 位随机值并写入此处；
#        手动部署时必须设置为 32+ 位随机字符串（切勿使用弱默认值）。
# 注意：留空或保持占位符时，litellm 与 Claude Code（devpilot-claude-litellm 容器）将拒绝启动（强制安全）。
LITELLM_MASTER_KEY=change-me-to-strong-litellm-key
# litellm 代理地址（一般无需改；如自定义部署可指向其它 litellm 端点）
LITELLM_PROXY_URL=http://127.0.0.1:4000

# ============================================================
# 时区配置
# ============================================================
TZ=Asia/Shanghai

# ============================================================
# 服务自动部署配置
# ============================================================
DEVPILOT_AUTO_DEPLOY=false

# ============================================================
# 组件版本配置（已集成到 versions.env，无需在此配置）
# ============================================================
# source ./versions.env  # init.sh 会自动加载

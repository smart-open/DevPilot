# ============================================================
# DevPilot 组件版本配置（单一配置源）
# 所有脚本和 Dockerfile 统一从此文件读取版本号
# 修改版本只需编辑该文件，无需多处同步
# ============================================================

# Node.js 基础镜像版本（推荐 Node 24 LTS）
# 支持范围：Node 22.22.3+、24.15+、25.9+（OpenClaw 要求）
NODE_IMAGE_TAG=24.17.0-bookworm

# OpenClaw 版本
# 安装时使用 npm install -g openclaw@${OPENCLAW_VERSION}
OPENCLAW_VERSION=2026.7.1-2

# CC-Switch Web 版本
CC_SWITCH_VERSION=v0.21.0

# Claude Code 版本
CLAUDE_CODE_VERSION=2.1.220

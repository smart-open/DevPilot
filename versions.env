# ============================================================
# DevPilot 组件版本配置（单一配置源）
# 所有脚本和 Dockerfile 统一从此文件读取版本号
# 修改版本只需编辑该文件，无需多处同步
# ============================================================

# Node.js 基础镜像版本（推荐 Node 24 LTS）
# 支持范围：Node 22.22.3+、24.15+、25.9+（OpenClaw 要求）
NODE_IMAGE_TAG=24.17.0-bookworm

# OpenClaw 版本
# 安装时使用 npm install -g openclaw@${OPENCLAW_VERSION}
OPENCLAW_VERSION=2026.7.1-2


# Claude Code 版本
CLAUDE_CODE_VERSION=2.1.241

# LiteLLM 代理版本（复刻 CC-Switch 本地路由：Anthropic /v1/messages -> OpenAI Chat Completions）
# 注意：1.82.7 / 1.82.8 存在供应链投毒（2026-03-24 TeamPCP 事件，凭证窃取+后门+K8s蠕虫，PyPI 已隔离），固定使用干净的 1.82.6
# 可选升级：官方已出 1.83.0 干净版（新 CI/CD v2 流水线），如需升级改 LITELLM_VERSION=1.83.0 并测试
LITELLM_VERSION=1.82.6

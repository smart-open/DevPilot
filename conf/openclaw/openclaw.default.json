{
  "version": "0.0.1",
  "language": "zh-CN",
  "ai": {
    "provider": "agnes",
    "providers": {
      "agnes": {
        "type": "openai",
        "baseUrl": "{{AGNES_BASE_URL}}",
        "apiKey": "{{AGNES_API_KEY}}",
        "api": "openai-completions",
        "models": [
          {
            "name": "agnes-2.0-flash",
            "contextWindow": 256000,
            "maxTokens": 8192
          },
          {
            "name": "agnes-image-2.1-flash",
            "contextWindow": 4096,
            "maxTokens": 4096
          },
          {
            "name": "agnes-video-v2.0",
            "contextWindow": 4096,
            "maxTokens": 4096
          }
        ]
      }
    },
    "defaultModel": "agnes/agnes-2.0-flash"
  },
  "gateway": {
    "enabled": true,
    "token": "{{OPENCLAW_GATEWAY_TOKEN}}",
    "deviceAuth": false,
    "port": 18789
  },
  "channels": {
    "feishu": {
      "enabled": true,
      "appId": "{{FEISHU_APP_ID}}",
      "appSecret": "{{FEISHU_APP_SECRET}}"
    }
  },
  "redis": {
    "url": "redis://default:{{REDIS_PASSWORD}}@redis:6379"
  }
}

{
  "version": "0.0.1",
  "language": "zh-CN",
  "models": {
    "mode": "merge",
    "providers": {
      "agnes": {
        "baseUrl": "{{AGNES_BASE_URL}}",
        "apiKey": "{{AGNES_API_KEY}}",
        "api": "openai-completions",
        "models": [
          {
            "id": "agnes-2.5-flash",
            "name": "Agnes 2.5 Flash",
            "contextWindow": 256000,
            "maxTokens": 8192
          },
          {
            "id": "agnes-image-2.1-flash",
            "name": "Agnes Image 2.1 Flash",
            "contextWindow": 4096,
            "maxTokens": 4096
          },
          {
            "id": "agnes-video-v2.0",
            "name": "Agnes Video 2.0",
            "contextWindow": 4096,
            "maxTokens": 4096
          }
        ]
      },
      "deepseek": {
        "baseUrl": "{{DEEPSEEK_BASE_URL}}",
        "apiKey": "{{DEEPSEEK_API_KEY}}",
        "api": "openai-completions",
        "models": [
          {
            "id": "DeepSeek-V4-Flash",
            "name": "DeepSeek V4 Flash",
            "contextWindow": 128000,
            "maxTokens": 8192
          }
        ]
      },
      "glm": {
        "baseUrl": "{{GLM_BASE_URL}}",
        "apiKey": "{{GLM_API_KEY}}",
        "api": "openai-completions",
        "models": [
          {
            "id": "GLM-5.2",
            "name": "GLM 5.2",
            "contextWindow": 128000,
            "maxTokens": 8192
          }
        ]
      },
      "ark": {
        "baseUrl": "{{ARK_BASE_URL}}",
        "apiKey": "{{ARK_API_KEY}}",
        "api": "openai-completions",
        "models": [
          {
            "id": "doubao-seed-2.1-turbo",
            "name": "Doubao Seed 2.1 Turbo",
            "contextWindow": 256000,
            "maxTokens": 8192
          }
        ]
      },
      "bailian": {
        "baseUrl": "{{BAILIAN_BASE_URL}}",
        "apiKey": "{{BAILIAN_API_KEY}}",
        "api": "openai-completions",
        "models": [
          {
            "id": "Qwen3.7-Plus",
            "name": "Qwen 3.7 Plus",
            "contextWindow": 128000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": "{{ACTIVE_DEFAULT_MODEL}}"
    }
  },
  "gateway": {
    "enabled": true,
    "bind": "lan",
    "token": "{{OPENCLAW_GATEWAY_TOKEN}}",
    "deviceAuth": false,
    "port": 18789,
    "controlUi": {
      "allowInsecureAuth": true,
      "allowedOrigins": ["http://localhost:18789", "http://127.0.0.1:18789"]
    }
  },
  "plugins": {
    "allow": ["feishu"],
    "entries": {
      "feishu": {
        "enabled": true
      }
    }
  },
  "channels": {
    "feishu": {
      "enabled": true,
      "dmPolicy": "pairing",
      "accounts": {
        "main": {
          "appId": "{{FEISHU_APP_ID}}",
          "appSecret": "{{FEISHU_APP_SECRET}}",
          "botName": "{{FEISHU_BOT_NAME}}"
        }
      }
    }
  },
  "redis": {
    "url": "redis://default:{{REDIS_PASSWORD}}@127.0.0.1:6379"
  }
}

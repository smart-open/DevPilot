{
  "version": "0.0.1",
  "language": "zh-CN",
  "ai": {
    "provider": "{{ACTIVE_PROVIDER}}",
    "providers": {
      "agnes": {
        "type": "openai",
        "baseUrl": "{{AGNES_BASE_URL}}",
        "apiKey": "{{AGNES_API_KEY}}",
        "api": "openai-completions",
        "models": [
          {
            "name": "agnes-2.5-flash",
            "contextWindow": 256000,
            "maxTokens": 8192
          },
          {
            "name": "agnes-image-2.1-flash",
            "contextWindow": 4096,
            "maxTokens": 4096
          },
          {
            "name": "agnes-video-v2.0",
            "contextWindow": 4096,
            "maxTokens": 4096
          }
        ]
      },
      "deepseek": {
        "type": "openai",
        "baseUrl": "{{DEEPSEEK_BASE_URL}}",
        "apiKey": "{{DEEPSEEK_API_KEY}}",
        "api": "openai-completions",
        "models": [
          {
            "name": "DeepSeek-V4-Flash",
            "contextWindow": 128000,
            "maxTokens": 8192
          }
        ]
      },
      "glm": {
        "type": "openai",
        "baseUrl": "{{GLM_BASE_URL}}",
        "apiKey": "{{GLM_API_KEY}}",
        "api": "openai-completions",
        "models": [
          {
            "name": "GLM-5.2",
            "contextWindow": 128000,
            "maxTokens": 8192
          }
        ]
      },
      "ark": {
        "type": "openai",
        "baseUrl": "{{ARK_BASE_URL}}",
        "apiKey": "{{ARK_API_KEY}}",
        "api": "openai-completions",
        "models": [
          {
            "name": "doubao-seed-2.1-turbo",
            "contextWindow": 256000,
            "maxTokens": 8192
          }
        ]
      },
      "bailian": {
        "type": "openai",
        "baseUrl": "{{BAILIAN_BASE_URL}}",
        "apiKey": "{{BAILIAN_API_KEY}}",
        "api": "openai-completions",
        "models": [
          {
            "name": "Qwen3.7-Plus",
            "contextWindow": 128000,
            "maxTokens": 8192
          }
        ]
      }
    },
    "defaultModel": "{{ACTIVE_DEFAULT_MODEL}}"
  },
  "gateway": {
    "enabled": true,
    "token": "{{OPENCLAW_GATEWAY_TOKEN}}",
    "deviceAuth": false,
    "port": 18789
  },
  "channels": {
    "feishu": {
      "enabled": true,
      "appId": "{{FEISHU_APP_ID}}",
      "appSecret": "{{FEISHU_APP_SECRET}}"
    }
  },
  "redis": {
    "url": "redis://default:{{REDIS_PASSWORD}}@redis:6379"
  }
}

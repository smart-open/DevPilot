# Git
.git
.gitignore
.gitattributes

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
cicd/

# 容器内公共函数库需要 COPY 进镜像（commit 1b46d88 引入）；
# 其它 cicd 子目录仍排除（部署脚本不走镜像路径）。
!cicd/lib/
!cicd/lib/common.sh

# 文档
*.md

# 运行时数据（不打包到镜像）
data/
logs/
backups/
workspace/

# 环境变量（不打包到镜像）
.env
.env.*
!.env.example

# 系统文件
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.idea/
.vscode/
*.code-workspace

# 临时文件
*.tmp
*.bak
*.log
